<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the tablet's own look (One UI on Samsung) and its dark mode. -->
    <style name="Theme.MacPad" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
</resources>
